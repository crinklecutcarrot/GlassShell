<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>GlassShell.Program</StartupObject>
    <AssemblyName>GlassShell</AssemblyName>
    <!-- WPF owns DPI awareness; Forms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Fonts/GlassShellDMSans-*.ttf" />
    <Resource Include="Assets/Icons/*.svg" />
    <Content Include="Assets/Fonts/OFL.txt;Assets/Icons/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

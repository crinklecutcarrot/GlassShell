{
  "manifest_version": 3,
  "name": "GlassShell YouTube Music Bridge",
  "version": "0.4.0",
  "description": "Synchronizes YouTube Music's current like state and queue with GlassShell.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1:45971/*", "https://music.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://music.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
